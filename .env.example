# Copy to .env.local and fill in. Never commit .env.local.
# All of these are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_.
# Read them in route handlers only — never in a client component.

# REQUIRED, and required in Vercel Production too. It declares which calendar
# the case dates belong to: S3's time-windowed rows are scored against it, and
# loadPolicy() refuses to load without exactly this value. See
# lib/policy/engine.ts, assertTimezonePinned.
#
# It is PROJECT_TZ and not TZ because Vercel reserves the name TZ and will not
# let you create it. The runtime therefore stays UTC, and getTodayIST() in
# lib/scoring/components.ts applies the +05:30 to the instant instead.
PROJECT_TZ="Asia/Kolkata"

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
STAFF_PASSCODE=
