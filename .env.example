# Copy to .env.local and fill in. Never commit .env.local.
# All of these are SERVER-ONLY. Never prefix any of them with NEXT_PUBLIC_.
# Read them in route handlers only — never in a client component.

# REQUIRED, and required in Vercel Production too. Vercel's runtime is UTC;
# S3's time-windowed rows are scored against the process's local calendar date,
# so an unpinned zone silently changes the score. loadPolicy() refuses to load
# without exactly this value. See lib/policy/engine.ts, assertTimezonePinned.
TZ=Asia/Kolkata

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
STAFF_PASSCODE=

# Serves the unimplemented stub routes their fixtures instead of a 503.
# Local and Preview only. NEVER set in Vercel Production. Delete this variable
# in the same PR that wires the real pipeline.
STUB_MODE=1
